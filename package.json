{
  "name": "d-bee-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "自律蜜蜂（D-Bee）品牌官网 · 零依赖静态站，由 src/ 构建出 app/",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/check-facts.mjs",
    "selftest": "node tools/check-facts.mjs --selftest",
    "redtest": "node tools/check-facts.mjs --redtest",
    "verify": "npm run build && npm run selftest && npm run redtest && npm run check",
    "dev": "python -m http.server 8080 --bind 127.0.0.1 --directory app"
  },
  "engines": {
    "node": ">=18"
  }
}
